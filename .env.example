DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/crown
REDIS_URL=redis://redis:6379/0

FRONTEND_ORIGIN=https://crown.skykraft.su
COOKIE_SECURE=true
COOKIE_NAME=crown_api_key

# Google Gemini
API_GEMINI=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.5-flash-lite

# SOCKS для выхода в Google
AI_PROXY_URL=socks5h://host.docker.internal:11080

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SEC=60
MAX_PDF_BYTES=52428800

TZ=Europe/Moscow
